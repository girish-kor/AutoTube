# AutoTube environment variables — copy to .env and fill in values.
# See docs/CONFIG.md for full reference. Never commit .env.

### n8n core
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_HOST=
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://<host>/
GENERIC_TIMEZONE=Asia/Kolkata
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

### Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_N8N=n8n
POSTGRES_DB_AUTOTUBE=autotube
POSTGRES_USER=autotube
POSTGRES_PASSWORD=

### Media worker
MEDIA_WORKER_BASE_URL=http://media-worker:8000
MEDIA_ROOT=/data/autotube
WHISPER_MODEL_SIZE=small
TTS_DEFAULT_VOICE=en-US-AndrewNeural

### LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM_LIMIT=15
OLLAMA_BASE_URL=http://ollama:11434

### YouTube (per channel; created once as an n8n OAuth2 credential, listed here for reference only)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

### Cross-posting
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

### Compliance / alerting
AUDD_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

### Runtime tuning (bootstrap defaults; mirrored into Postgres `config` table for dynamic updates)
MAX_CONCURRENT_VIDEOS=3
VISUAL_BATCH_SIZE=3
MAX_RETRIES=5
SHORTS_PER_VIDEO=3

### Test mode
TEST_MODE=false
