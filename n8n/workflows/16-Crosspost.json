        "postgres": {
          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.remaining}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "4756c5c8-1b05-42dd-b953-7438b897c550",
      "name": "All Combinations Recorded?",
