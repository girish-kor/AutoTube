      "typeVersion": 2.2,
      "position": [
        520,
        620
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE videos SET stage = 'CROSSPOSTED' WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$('Trigger').first().json.video_id] }}"
