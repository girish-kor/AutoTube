{
  "name": "09-Captioning",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "video_id"
            }
          ]
        }
      },
      "id": "9e1b36c6-3ad2-4be5-9162-1b91d3023bd6",
      "name": "Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM videos WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$json.video_id] }}"
        }
      },
      "id": "45d61909-68fe-4f73-9faf-6211aa3ed408",
      "name": "Load Video",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        260
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      },
      "notes": "Guard: only proceeds if stage = 'RENDERED' (checked in the following If node); otherwise NoOp exit (docs/WORKFLOW.md Sub-Workflow Contract step 2)."
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.stage}}",
              "rightValue": "RENDERED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "7b3cc9df-f53f-496e-9336-ad58b476d721",
      "name": "Guard: Stage = RENDERED?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        260
      ]
    },
    {
      "parameters": {},
      "id": "99508a30-d917-4710-b948-9d187047da0a",
      "name": "Exit: Wrong Stage",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1040,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.MEDIA_WORKER_BASE_URL}}/caption",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"channel_id\":\"={{$json.channel_id}}\",\"video_id\":\"={{$json.video_id}}\",\"render_path\":\"={{$json.render_path}}\",\"model_size\":\"={{$env.WHISPER_MODEL_SIZE}}\"}"
      },
      "id": "52c76cc9-e437-4a07-afd0-236f289d0e73",
      "name": "Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        260
      ],
      "notes": "docs/N8N_NODES.md preamble: Response Format=JSON, Timeout=300000ms, Retry 3x/5000ms (media jobs are slow).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "media-worker-api"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// SRT total duration within 2% of render duration (docs/CONTENT_PIPELINE.md §3).\nif ($json.coverage_ratio < 0.98 || $json.coverage_ratio > 1.02) {\n  throw new Error(`caption coverage ratio ${$json.coverage_ratio} outside 2% tolerance`);\n}\nreturn [{ json: $json }];"
      },
      "id": "0a9f84cb-9937-4325-adae-e5695e55a44c",
      "name": "Validate Coverage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE videos SET captions_path = $1, render_path = $2, stage = 'CAPTIONED' WHERE id = $3",
        "options": {
          "queryReplacement": "={{ [$json.srt_path, $json.captioned_render_path, $json.video_id] }}"
        }
      },
      "id": "d96079b4-e9f2-4a05-8181-bd15c5a6ba63",
      "name": "Persist",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        440
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      }
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Load Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Video": {
      "main": [
        [
          {
            "node": "Guard: Stage = RENDERED?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guard: Stage = RENDERED?": {
      "main": [
        [
          {
            "node": "Transcribe",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Exit: Wrong Stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcribe": {
      "main": [
        [
          {
            "node": "Validate Coverage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Coverage": {
      "main": [
        [
          {
            "node": "Persist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
