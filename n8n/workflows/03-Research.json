      "notes": "Guard: only proceeds if stage = 'TOPIC_SELECTED' (checked in the following If node); otherwise NoOp exit (docs/WORKFLOW.md Sub-Workflow Contract step 2)."
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.stage}}",
              "rightValue": "TOPIC_SELECTED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "293d888b-3402-4e69-9739-aa958ad4dfb9",
      "name": "Guard: Stage = TOPIC_SELECTED?",
