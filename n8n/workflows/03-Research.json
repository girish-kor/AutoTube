          "timeout": 300000
        }
      },
      "id": "83fd6089-5eaa-4750-9f33-6787b87b97df",
      "name": "DuckDuckGo Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        440
