      },
      "id": "011334b3-ea3e-482f-9adc-5657c986b230",
      "name": "DuckDuckGo Extract",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1.2,
      "position": [
        780,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{$env.GEMINI_MODEL || 'gemini-2.0-flash'}}:generateContent",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"=Compile factual notes for a video about \\\"{{$json.topic_title}}\\\" using ONLY the source\\\\nmaterial below. Do not add facts not present in the sources. For each fact,\\\\ncopy the exact source_url it came from. Produce at least 8 distinct facts if\\\\nthe sources support it; if they don't, return fewer — never invent facts to\\\\nreach a count. Flag any source material that is opinion, not fact.\\\\n\\\\nSources:\\\\n{{JSON.stringify($json.sources)}}\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"responseSchema\":{\"type\":\"object\",\"properties\":{\"facts\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"claim\":{\"type\":\"string\"},\"source_url\":{\"type\":\"string\"}},\"required\":[\"claim\",\"source_url\"]}}},\"required\":[\"facts\"]}}}"
      },
      "id": "93579797-2a73-41b7-b357-dd862875e296",
      "name": "Compile Research (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        440
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "gemini-api"
        }
      },
      "notes": "docs/AI_PIPELINE.md prompt/schema. Pre-flight-checked against api_usage/gemini before call; falls back to Ollama on quota exhaustion per docs/AI_PIPELINE.md §0 (fallback branch omitted here for diagram clarity, implement per that section).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.facts.length}}",
              "rightValue": 8,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        }
      },
      "id": "c8284d08-7c31-4d7c-b978-54064333ecb0",
      "name": "Validate Non-Empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1300,
        440
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE videos SET research_json = $1, stage = 'RESEARCHED' WHERE id = $2",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json), $json.video_id] }}"
        }
      },
      "id": "2fa9da9b-a86b-43ee-a358-8d5adcaf88a9",
      "name": "Persist",
