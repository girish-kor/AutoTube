        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"=Write a short-form YouTube Shorts title/description/tags for this clip, derived\\\\nfrom the parent video's metadata and this clip's own content. Title must include\\\\n#Shorts. Keep description to 1-2 sentences plus 3-5 tags inherited from the\\\\nparent's tag set, plus 1-2 trending hashtags.\\\\n\\\\nParent title: {{$json.parent_title}}\\\\nParent tags: {{JSON.stringify($json.parent_tags)}}\\\\nClip window: {{$json.start_ts}}-{{$json.end_ts}}s\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"responseSchema\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"title\",\"description\",\"tags\"]}}}"
      },
      "id": "250088b4-5f92-4419-9ed0-9f8483a8512c",
      "name": "Generate Short SEO (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        260
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "gemini-api"
        }
      },
      "notes": "docs/AI_PIPELINE.md prompt/schema. Pre-flight-checked against api_usage/gemini before call; falls back to Ollama on quota exhaustion per docs/AI_PIPELINE.md §0 (fallback branch omitted here for diagram clarity, implement per that section).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "batchSize": 1
        }
      },
      "id": "6782a34e-18ad-459a-b7fa-76fc4f3f4610",
      "name": "Loop & Upload",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1040,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://youtube.googleapis.com/upload/youtube/v3/videos?part=snippet,status&uploadType=resumable",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"snippet\":{\"title\":\"={{$json.title}} #Shorts\",\"description\":\"={{$json.description}}\",\"tags\":\"={{$json.tags}}\"},\"status\":{\"privacyStatus\":\"={{$env.TEST_MODE === 'true' ? 'private' : 'public'}}\",\"selfDeclaredMadeForKids\":false,\"containsSyntheticMedia\":true}}"
      },
      "id": "9e7f7797-bfe6-4b4c-8e81-ef5e6fe2e44a",
      "name": "Upload Short",
