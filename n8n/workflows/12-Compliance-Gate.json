    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Mirrors media-worker/app/compliance_scan.py's rule (docs/CONTENT_PIPELINE.md\n// §4.1) — kept as a Postgres-fed Code node here because the asset list lives\n// in Postgres, not something media-worker can query itself.\nconst ALLOWED_SOURCE_TOOLS = [\"pollinations\", \"edge-tts\", \"ffmpeg\", \"pillow\"];\n\nfunction checkAssetProvenance(assets) {\n  if (!assets || assets.length === 0) {\n    return { passed: false, details: \"no assets recorded for this video\" };\n  }\n  const disallowed = assets.filter((a) => !ALLOWED_SOURCE_TOOLS.includes(a.source_tool));\n  if (disallowed.length > 0) {\n    const tools = [...new Set(disallowed.map((a) => a.source_tool))];\n    return { passed: false, details: `disallowed source_tool(s) present: ${tools.join(\", \")}` };\n  }\n  return { passed: true, details: `all ${assets.length} asset(s) sourced from allowed tools` };\n}\n\nreturn [{ json: { check_type: 'asset_provenance', ...checkAssetProvenance($input.all().map(i => i.json)) } }];"
      },
      "id": "6cafb740-12e0-4167-ac49-42b893842f0f",
      "name": "Check: Asset Provenance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.audd.io/",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"url\":\"={{$('Load Video').first().json.render_path}}\"}"
      },
      "id": "d0324ec0-fdb1-4743-9200-d03c630d8e10",
      "name": "Check: Audio Fingerprint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
