    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM videos WHERE stage IN ('PUBLISHED','SHORTS_PUBLISHED','CROSSPOSTED') AND published_at > now() - interval '90 days'",
        "options": {}
      },
      "id": "1a26d072-f438-439b-b4ce-3c76b9c2baa4",
      "name": "Fetch Trackable Videos",
