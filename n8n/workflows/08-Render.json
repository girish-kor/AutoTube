    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Assembles the media-worker `/render` manifest (docs/N8N_NODES.md workflow\n// 08) from the fact-checked script's per-scene start_ts (set in\n// 06-Voice-Synthesis) joined against the generated image assets.\nfunction buildRenderManifest(channelId, videoId, audioPath, scenes, assets, resolution) {\n  const assetByScene = new Map(\n    assets.filter((a) => a.type === \"image\").map((a) => [a.scene_index, a])\n  );\n\n  const images = scenes.map((scene, index) => {\n    const asset = assetByScene.get(index);\n    if (!asset) throw new Error(`missing image asset for scene_index ${index}`);\n    const nextScene = scenes[index + 1];\n    return {\n      path: asset.file_path,\n      start_ts: scene.start_ts,\n      end_ts: nextScene ? nextScene.start_ts : scene.start_ts + (scene.duration_estimate_sec || 0),\n    };\n  });\n\n  return {\n    channel_id: channelId,\n    video_id: videoId,\n    audio_path: audioPath,\n    images,\n    resolution: resolution || \"1920x1080\",\n  };\n}\n\nconst video = $('Load Video and Assets').first().json;\nconst assets = $input.all().map(i => i.json);\nreturn [{ json: buildRenderManifest(video.channel_id, video.video_id, video.audio_path, video.script_json.scenes, assets, '1920x1080') }];"
      },
      "id": "34cebdf8-1ab3-4b1c-918d-c5cce75d0414",
      "name": "Build Render Manifest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.MEDIA_WORKER_BASE_URL}}/render",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "345db07e-b109-45af-9709-384132e4e0e8",
      "name": "Render Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        440
      ],
      "notes": "docs/N8N_NODES.md preamble: Response Format=JSON, Timeout=300000ms, Retry 3x/5000ms (media jobs are slow).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{Math.abs($json.duration_sec - $('Load Video and Assets').first().json.audio_duration_sec) / $('Load Video and Assets').first().json.audio_duration_sec}}",
              "rightValue": 0.05,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "notes": "Render duration within +/-5% of audio duration (docs/CONTENT_PIPELINE.md §3)."
        }
      },
      "id": "680278a8-5057-4cc2-8f74-eda8d709e124",
