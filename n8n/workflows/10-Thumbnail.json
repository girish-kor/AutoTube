        260
      ],
      "notes": "docs/N8N_NODES.md preamble: Response Format=JSON, Timeout=300000ms, Retry 3x/5000ms (media jobs are slow).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE videos SET thumbnail_path = $1, stage = 'THUMBNAIL_READY' WHERE id = $2",
        "options": {
          "queryReplacement": "={{ [$json.file_path, $('Load Video').first().json.video_id] }}"
