          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO videos (channel_id, topic_id, stage) VALUES ($1, $2, 'TOPIC_SELECTED') RETURNING id",
        "options": {
          "queryReplacement": "={{ [$json.channel_id, $json.topic_id] }}"
        }
      },
      "id": "47d31ea7-fd51-4518-8c88-4a10aca61fb7",
      "name": "Create Video Row",
