{
  "name": "02-Topic-Selection",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "channel_id"
            }
          ]
        }
      },
      "id": "bcdf12e4-81e7-40b3-ab5e-840469f3643d",
      "name": "Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT count(*) FROM videos WHERE channel_id = $1 AND stage NOT IN ('PUBLISHED','SHORTS_PUBLISHED','CROSSPOSTED','FAILED')) AS in_flight_count, (SELECT daily_long_form_quota FROM channels WHERE id = $1) AS daily_quota",
        "options": {
          "queryReplacement": "={{ [$json.channel_id] }}"
        }
      },
      "id": "bbe01b58-d218-430e-a354-bcdebdf85586",
      "name": "Guard: video-in-flight?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        260
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.in_flight_count}}",
              "rightValue": "={{$json.daily_quota}}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ]
        }
      },
      "id": "78a71734-71ea-476d-a8e1-1cd74573c088",
      "name": "Guard: Under Quota?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        260
      ]
    },
    {
      "parameters": {},
      "id": "f85f9acf-09b6-4cc0-8c08-ec726407b94d",
      "name": "Exit: Quota Reached",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1040,
        260
      ],
      "notes": "Safe re-dispatch — Master will retry next cycle once in-flight videos advance."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM topics WHERE channel_id = $1 AND status = 'PENDING' AND discovered_date = CURRENT_DATE",
        "options": {
          "queryReplacement": "={{ [$json.channel_id] }}"
        }
      },
      "id": "2525b66d-6768-4e85-b1e9-2c47b8584561",
      "name": "Fetch Pending Topics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1300,
        260
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value FROM config WHERE key = 'topic_scoring_weights'",
        "options": {}
      },
      "id": "ad8ebac2-0074-4cf2-ac78-e676fcd22ad3",
      "name": "Load Scoring Weights",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        260
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{$env.GEMINI_MODEL || 'gemini-2.0-flash'}}:generateContent",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"contents\":[{\"parts\":[{\"text\":\"=You are scoring candidate YouTube video topics for the niche \\\"{{$json.niche}}\\\".\\\\nFor each topic, score 0-100 on: recency, trend_strength, evergreen_potential,\\\\ncompetition_gap (opportunity where saturation is low), niche_fit.\\\\nCombine using these weights: {{JSON.stringify($json.weights)}}.\\\\nReject (score 0) any topic that is: sexual, violent, hateful, medical/legal/financial\\\\nadvice framed as fact, about a real private individual, or clearly designed to\\\\nmislead (title promises content the topic can't deliver).\\\\nReturn strict JSON only.\\\\n\\\\nTopics:\\\\n{{JSON.stringify($json.topics)}}\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"responseSchema\":{\"type\":\"object\",\"properties\":{\"scored\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"topic_id\":{\"type\":\"string\"},\"llm_score\":{\"type\":\"number\"},\"rejected\":{\"type\":\"boolean\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"topic_id\",\"llm_score\",\"rejected\"]}}},\"required\":[\"scored\"]}}}"
      },
      "id": "4348d30d-bbff-42ae-8548-eefb19135983",
      "name": "Score Topics (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        440
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "gemini-api"
        }
      },
      "notes": "docs/AI_PIPELINE.md prompt/schema. Pre-flight-checked against api_usage/gemini before call; falls back to Ollama on quota exhaustion per docs/AI_PIPELINE.md §0 (fallback branch omitted here for diagram clarity, implement per that section).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const scored = $input.first().json.scored.filter(s => !s.rejected);\nif (!scored.length) throw new Error('no eligible topics after scoring/rejection');\nscored.sort((a, b) => b.llm_score - a.llm_score);\nreturn [{ json: scored[0] }];"
      },
      "id": "e9651271-bf98-4fe1-ab55-54710a49b2ca",
      "name": "Pick Top",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        440
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE topics SET status = 'SELECTED', llm_score = $1 WHERE id = $2",
        "options": {
          "queryReplacement": "={{ [$json.llm_score, $json.topic_id] }}"
        }
      },
      "id": "9c4ede6f-5fd2-4b2c-bb50-b9930a0840d7",
      "name": "Mark Selected",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        780,
        440
      ],
      "credentials": {
        "postgres": {
          "name": "postgres-autotube"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE topics SET status = 'REJECTED' WHERE channel_id = $1 AND discovered_date = CURRENT_DATE AND id != $2",
        "options": {
          "queryReplacement": "={{ [$json.channel_id, $json.topic_id] }}"
        }
      },
      "id": "0f3b846b-e74f-47cc-9e76-2ffedda275d7",
      "name": "Mark Rejected",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1040,
